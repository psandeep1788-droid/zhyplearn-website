# ZhypLearn — Environment Variables (example)
# Copy to .env.local for local development and fill in real values.
# Never commit .env or .env.local — this file is the only one tracked in git.

# --- Deployment identity (see src/lib/env.ts) ---
# SITE_URL: the public URL of this deployment. Set per-environment in
# wrangler.jsonc "vars" for Cloudflare; leave unset locally to fall back to
# http://localhost:3000.
SITE_URL=""
# IS_PRODUCTION: leave unset/"false" everywhere except a real, approved
# production launch — controls both the sitemap/JSON-LD domain and whether
# robots.txt allows indexing.
IS_PRODUCTION="false"

# --- Database (Neon PostgreSQL — your own ZhypLearn project, never the CRM's) ---
DATABASE_URL=""

# --- Email notifications (Resend) ---
# Leave unset locally and the app logs "would send" instead of failing —
# the demo-request flow still works end-to-end without a real key.
RESEND_API_KEY=""
